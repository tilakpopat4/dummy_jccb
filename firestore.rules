rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // HELPER FUNCTIONS (RBAC & Authentication)
    // ===============================================================

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Fetch user document from 'users' collection
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Check if user is active
    function isUserActive() {
      return isAuthenticated() && (
        request.auth.token.isActive == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().isActive == true)
      );
    }

    // Check if the requesting user is a Super Admin (Head Office)
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'admin' &&
         getUserData().isActive == true)
      );
    }

    // Check if user is a Branch Manager
    function isBranchManager() {
      return isAuthenticated() && (
        request.auth.token.role == 'branch_manager' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'branch_manager' &&
         getUserData().isActive == true)
      );
    }

    // Check if user belongs to a specific branch
    function isBranchMember(targetBranchId) {
      return isAuthenticated() && isUserActive() && (
        request.auth.token.branchId == targetBranchId ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().branchId == targetBranchId)
      );
    }

    // Check if user is operating on their own document
    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ===============================================================
    // COLLECTION RULES
    // ===============================================================

    // 1. USERS COLLECTION
    // - Admin: Full Read/Write (can create users, assign branches and roles)
    // - Users: Can read their own profile, can update lastLoginAt
    match /users/{userId} {
      allow read: if isAdmin() || isSelf(userId);
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        isSelf(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'branchId', 'isActive'])
      );
    }

    // 2. BRANCHES COLLECTION
    // - Admin: Full Read/Write (Add, Edit, Activate/Deactivate, Delete)
    // - Authenticated Active Users: Read-Only (to load branch lists/names)
    match /branches/{branchId} {
      allow read: if isUserActive() || isAdmin();
      allow write: if isAdmin();
    }

    // 3. LOANS COLLECTION
    // - Admin: Full Read/Write/Delete across all branches
    // - Branch Staff/Manager: Read/Create/Update ONLY for their assigned branch
    // - Non-admin cannot delete loans (only status change or soft delete by Admin)
    match /loans/{loanId} {
      // Read allowed if Admin or if the loan belongs to the user's branch
      allow read: if isAdmin() || (
        isUserActive() && (
          resource == null || isBranchMember(resource.data.branchId)
        )
      );

      // Create allowed if Admin or if loan's branchId matches user's branch
      allow create: if isAdmin() || (
        isUserActive() &&
        request.resource.data.branchId != null &&
        isBranchMember(request.resource.data.branchId) &&
        request.resource.data.createdBy == request.auth.uid
      );

      // Update allowed if Admin or if updating own branch loan (cannot change branchId or createdBy)
      allow update: if isAdmin() || (
        isUserActive() &&
        isBranchMember(resource.data.branchId) &&
        request.resource.data.branchId == resource.data.branchId &&
        request.resource.data.createdBy == resource.data.createdBy
      );

      // Delete allowed ONLY for Admin (prevent accidental loss by branch users)
      allow delete: if isAdmin();
    }

    // 4. DAILY GOLD RATES
    // - Admin: Can set/update daily gold rates
    // - Authenticated Active Users: Read-only access to get today's rates
    match /rates/{rateDoc} {
      allow read: if isUserActive() || isAdmin();
      allow write: if isAdmin();
    }

    // 5. GLOBAL SETTINGS & PRODUCT SCHEMES
    // - Admin: Can modify interest slabs, loan schemes, system configs
    // - Authenticated Active Users: Read-only access
    match /settings/{settingDoc} {
      allow read: if isUserActive() || isAdmin();
      allow write: if isAdmin();
    }

    // 6. AUDIT LOGS
    // - Admin: Read all logs
    // - Branch Manager: Read logs of their branch
    // - Authenticated Users: Create audit log entries (append-only)
    match /audit_logs/{logId} {
      allow read: if isAdmin() || (
        isBranchManager() && isBranchMember(resource.data.branchId)
      );
      allow create: if isUserActive() && request.resource.data.performedBy == request.auth.uid;
      allow update, delete: if false; // Audit logs are immutable
    }
  }
}
